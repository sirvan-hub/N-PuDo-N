# Local development defaults to SQLite. Never commit real credentials.
NODE_ENV=development
DB_TYPE=sqlite
SQLITE_DATABASE=dev.db
SQLITE_SYNCHRONIZE=true

# PostgreSQL (set DB_TYPE=postgres; synchronization is always disabled)
# NODE_ENV=production
# DB_TYPE=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=pudo
# DB_USER=pudo_app
# DB_PASSWORD=replace-with-a-secret-from-your-secret-manager
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED_FALSE=false
# TYPEORM_SYNCHRONIZE must not be set to true for PostgreSQL

# Pudo-N network-entry fee as a percentage of actual postal postage; allowed range 30-40.
PUDO_ENTRY_FEE_PERCENT=30

# Private parcel evidence storage (create this bucket as PRIVATE in Supabase Storage).
# Keep this server-side secret out of PWA/Android and source control.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_STORAGE_BUCKET=pudo-evidence
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-side-secret
