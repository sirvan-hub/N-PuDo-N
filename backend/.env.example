# Local development defaults to SQLite. Never commit real credentials.
NODE_ENV=development
DB_TYPE=sqlite
SQLITE_DATABASE=dev.db
SQLITE_SYNCHRONIZE=true

# PostgreSQL (set DB_TYPE=postgres; synchronization is always disabled)
# NODE_ENV=production
# DB_TYPE=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=pudo
# DB_USER=pudo_app
# DB_PASSWORD=replace-with-a-secret-from-your-secret-manager
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED_FALSE=false
# TYPEORM_SYNCHRONIZE must not be set to true for PostgreSQL
